// Caso 2: únicamente errores sintácticos.
// Todos los caracteres pertenecen al vocabulario de Compiscript.

let nombre: string = "Compiscript"
const total: integer = 10

if (total > 5 {
  print(nombre)
}

while (total < 20) {
  total = total + 1
}

function sumar(a: integer, b: integer): integer {
  return a + b
}

print(sumar(total, 2))

