{
  "name": "dlp-proyectos-01-02-antlr",
  "version": "1.0.0",
  "private": true,
  "description": "IDE de Compiscript con análisis léxico, sintáctico y semántico, tabla de símbolos y ámbitos usando ANTLR4 + TypeScript.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "generate": "antlr4ts -Xexact-output-dir -visitor -listener -o src/generated src/grammars/Compiscript.g4",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli/run.ts",
    "cli:valid": "tsx src/cli/run.ts examples/compiscript/valid.cps --mode parser",
    "cli:error-lex": "tsx src/cli/run.ts examples/compiscript/lexical_errors.cps --mode lexer",
    "cli:error-syn": "tsx src/cli/run.ts examples/compiscript/syntax_errors.cps --mode parser",
    "desktop": "npm run build && electron .",
    "exe:portable": "npm run build && electron-builder --win portable --x64",
    "exe:installer": "npm run build && electron-builder --win nsis --x64",
    "cli:semantic-valid": "tsx src/cli/run.ts examples/semantic/valid_complete.cps --mode semantic",
    "cli:semantic-errors": "tsx src/cli/run.ts examples/semantic/semantic_errors.cps --mode semantic"
  },
  "build": {
    "appId": "gt.edu.uvg.dlpantlr",
    "productName": "Compiscript Semantic IDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Compiscript-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Compiscript-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "antlr4ts": "^0.5.0-alpha.4",
    "assert": "^2.1.0",
    "lucide-react": "^0.468.0",
    "process": "^0.11.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "antlr4ts-cli": "^0.5.0-alpha.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
